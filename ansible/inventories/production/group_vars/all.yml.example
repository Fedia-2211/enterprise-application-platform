---
# group_vars/all.yml — copy this file to all.yml and adjust the values.
#   cp all.yml.example all.yml
#
# all.yml is git-ignored. Passwords are NOT stored here: they are read from
# AWS SSM Parameter Store at runtime (create them first with `make ssm-params`).
# The private IPs are filled in by `make inventory` (see scripts/generate-inventory.sh).

# ── Project ───────────────────────────────────────────────────────────────────
project_name: enterprise-application-platform
app_environment: production # not `environment` — that name is reserved in Ansible
aws_region: us-east-1
app_domain: gitea.samadov.xyz
system_timezone: UTC
ntp_servers:
  - 169.254.169.123 # Amazon Time Sync Service

# ── Private IPs (from `terraform output`) ─────────────────────────────────────
db_private_ip: "{{ hostvars['db-01'].ansible_host }}"
app_server_1_ip: "{{ hostvars['app-01'].ansible_host }}"
app_server_2_ip: "{{ hostvars['app-02'].ansible_host }}"
s3_bucket: "CHANGE_ME" # terraform output -raw s3_bucket_name

# ── Secrets (pulled from SSM — never commit real values) ──────────────────────
ssm_prefix: "/{{ project_name }}/{{ app_environment }}"
mysql_root_password: "{{ lookup('aws_ssm', ssm_prefix + '/mysql/root_password', region=aws_region) }}"
mysql_app_password: "{{ lookup('aws_ssm', ssm_prefix + '/mysql/app_password', region=aws_region) }}"
rabbitmq_password: "{{ lookup('aws_ssm', ssm_prefix + '/rabbitmq/password', region=aws_region) }}"

# ── SSH hardening (common role) ───────────────────────────────────────────────
ops_user: ops
ops_user_shell: /bin/bash
ssh_port: 22
ssh_permit_root_login: "no"
ssh_password_authentication: "no"
ssh_max_auth_tries: 3
ssh_login_grace_time: 30

# ── Nginx ─────────────────────────────────────────────────────────────────────
nginx_worker_processes: auto
nginx_worker_connections: 1024
nginx_keepalive_timeout: 65
nginx_client_max_body_size: 100m

# ── Gitea ─────────────────────────────────────────────────────────────────────
gitea_version: "1.22.1"
gitea_user: git
gitea_group: git
gitea_home: /home/git
gitea_data_dir: /var/lib/gitea
gitea_config_dir: /etc/gitea
gitea_log_dir: /var/log/gitea
app_port: 3000

# ── MySQL ─────────────────────────────────────────────────────────────────────
mysql_app_db: gitea
mysql_app_user: gitea
mysql_bind_address: 0.0.0.0 # access is limited by the security group + UFW
mysql_data_dir: /var/lib/mysql
mysql_log_dir: /var/log/mysql
mysql_max_connections: 200
mysql_innodb_buffer_pool_size: 256M
backup_retention_days: 7

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
rabbitmq_user: gitea
rabbitmq_vhost: /gitea
rabbitmq_amqp_port: 5672
rabbitmq_management_port: 15672

# ── Memcached ─────────────────────────────────────────────────────────────────
memcached_port: 11211
memcached_memory_mb: 256
memcached_max_connections: 1024

# ── CloudWatch ────────────────────────────────────────────────────────────────
cloudwatch_log_group_prefix: "/app/{{ project_name }}/{{ app_environment }}" # matches the Terraform log groups
cloudwatch_metrics_namespace: EnterpriseAppPlatform
