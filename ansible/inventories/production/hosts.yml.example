---
# Example inventory. The real hosts.yml is generated from Terraform outputs:
#   make inventory
all:
  vars:
    ansible_user: ubuntu
    ansible_ssh_private_key_file: ~/.ssh/enterprise-application-platform-key.pem

  children:
    app_servers:
      hosts:
        app-01:
          ansible_host: 10.0.2.10
        app-02:
          ansible_host: 10.0.2.11

    message_queue:
      hosts:
        rabbitmq-01:
          ansible_host: 10.0.2.12

    cache:
      hosts:
        memcached-01:
          ansible_host: 10.0.2.13

    tools:
      hosts:
        jenkins-01:
          ansible_host: 10.0.3.10

    database:
      hosts:
        db-01:
          ansible_host: 10.0.4.10
          ansible_user: ec2-user

